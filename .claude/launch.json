{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "study-copilot",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "study-copilot-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=file:./data/preview/preview.db UPLOAD_DIR=./data/preview/uploads pnpm dev --port 3100"
      ],
      "port": 3100
    }
  ]
}