# SQLite database file (relative to the project root)
DATABASE_URL="file:./data/study.db"
# Directory where uploaded PDFs are stored (outside the public folder!)
UPLOAD_DIR="./data/uploads"
# Max upload size in megabytes
MAX_UPLOAD_MB=50
# Secret used to sign session cookies – generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Allow creating new accounts. Registration is always possible while no user exists.
ALLOW_REGISTRATION=false

# Time zone used for "today", due dates and calendar input
TZ="Europe/Berlin"
