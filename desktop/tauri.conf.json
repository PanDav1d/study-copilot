{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Copilot",
  "version": "1.0.0",
  "identifier": "app.studycopilot.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Study Copilot",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "build/server/": "server/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
