{
  "name": "dhbw-study-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "node --conditions=react-server --import tsx scripts/mcp-server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate && node scripts/copy-pdfjs.mjs",
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs && cd desktop && cargo tauri build",
    "desktop:dev": "node scripts/build-desktop.mjs && cd desktop && cargo tauri dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "geist": "^1.8.1",
    "jose": "6.2.12",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pdfjs-dist": "5.4.296",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  }
}
